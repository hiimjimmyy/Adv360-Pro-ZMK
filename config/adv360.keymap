#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        input_pw_mac: pw {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Y &kp M &kp M &kp I &kp J &kp N1 &kp N2 &kp N3 &kp EXCL &kp EXCL &kp RET>;
            label = "PW";
        };

        call_shortcat: shortcat {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(INSERT)>;
            label = "SHORTCAT";
            tap-ms = <0>;
        };

        switch_app_instance_mac: switch_instance {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(GRAVE)>;
            label = "SWITCH_INSTANCE";
            tap-ms = <0>;
        };

        vsc_goto_terminal: terminal {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(GRAVE)>;
            label = "TERMINAL";
        };

        switch_instance_window: switch_instance_window {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(GRAVE)>;
            label = "SWITCH_INSTANCE_WINDOW";
        };

        input_pw_window: input_pw_window {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LS(Y) &kp M &kp M &kp I &kp LS(J) &kp N8 &kp N2 &kp N1 &kp N5 &kp N1 &kp EXCL &kp N0 &kp N3 &kp N2 &kp N5 &kp RET>;
            label = "INPUT_PW_WINDOW";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        mac {
            display-name = "Base";
            bindings = <
&kp MINUS  &kp N1     &kp N2      &kp N3    &kp N4     &kp N5  &none                                                                                         &mo 4                     &kp N6  &kp N7    &kp N8        &kp N9    &kp N0    &kp EQUAL
&kp TAB    &kp Q      &kp W       &kp E     &kp R      &kp T   &vsc_goto_terminal                                                                            &switch_app_instance_mac  &kp Y   &kp U     &kp I         &kp O     &kp P     &kp BSLH
&kp ESC    &kp A      &kp S       &kp D     &kp F      &kp G   &kp LEFT_CONTROL    &kp LEFT_COMMAND  &kp LEFT_CONTROL      &kp RIGHT_COMMAND  &kp RIGHT_ALT  &kp RCTRL                 &kp H   &kp J     &kp K         &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z      &kp X       &kp C     &kp V      &kp B                                         &kp HOME              &kp PG_UP                                                   &kp N   &kp M     &kp COMMA     &kp DOT   &kp FSLH  &kp RSHFT
&mo 2      &kp GRAVE  &kp DELETE  &kp LEFT  &kp RIGHT          &kp BSPC            &call_shortcat    &kp END               &kp PG_DN          &kp ENTER      &kp SPACE                         &kp DOWN  &kp UP_ARROW  &kp LBKT  &kp RBKT  &mo 2
            >;
        };

        windows {
            display-name = "Base";
            bindings = <
&kp MINUS  &kp N1     &kp N2  &kp N3    &kp N4     &kp N5  &none                                                                                     &mo 4                    &kp N6  &kp N7    &kp N8        &kp N9    &kp N0    &kp EQUAL
&kp TAB    &kp Q      &kp W   &kp E     &kp R      &kp T   &vsc_goto_terminal                                                                        &switch_instance_window  &kp Y   &kp U     &kp I         &kp O     &kp P     &kp BSLH
&kp ESC    &kp A      &kp S   &kp D     &kp F      &kp G   &kp CAPS            &kp LEFT_CONTROL  &kp LEFT_WIN      &kp RIGHT_ALT  &kp RIGHT_CONTROL  &kp RCTRL                &kp H   &kp J     &kp K         &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z      &kp X   &kp C     &kp V      &kp B                                         &kp HOME          &kp PG_UP                                                  &kp N   &kp M     &kp COMMA     &kp DOT   &kp FSLH  &kp RSHFT
&mo 2      &kp GRAVE  &none   &kp LEFT  &kp RIGHT          &kp BSPC            &kp DEL           &kp END           &kp PG_DN      &kp ENTER          &kp SPACE                        &kp DOWN  &kp UP_ARROW  &kp LBKT  &kp RBKT  &mo 2
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&bl BL_TOG  &kp F1      &kp F2  &kp F3           &kp F4       &kp F5                &none                                                                         &mo 4      &kp F6  &kp F7          &kp F8          &kp F9           &kp F10           &kp K_SCREENSAVER
&none       &kp LA(F4)  &none   &none            &none        &kp C_BRIGHTNESS_INC  &kp C_VOLUME_UP                                                               &none      &none   &none           &mmv MOVE_UP    &none            &none             &none
&none       &none       &none   &none            &none        &kp C_BRIGHTNESS_DEC  &kp C_VOL_DN     &none  &kp GLOBE          &kp RIGHT_GUI   &kp RIGHT_CONTROL  &none      &none   &mmv MOVE_LEFT  &none           &mmv MOVE_RIGHT  &none             &none
&none       &none       &none   &none            &none        &none                                         &kp LG(LEFT)       &msc SCRL_UP                                  &none   &none           &mmv MOVE_DOWN  &none            &none             &none
&mo 2       &none       &none   &kp LS(LC(TAB))  &kp RC(TAB)                        &tog 3           &none  &kp LG(RIGHT)      &msc SCRL_DOWN  &mkp LCLK          &mkp RCLK          &msc MOVE_X(5)  &none           &msc MOVE_X(5)   &input_pw_window  &input_pw_mac
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp KP_SUBTRACT  &kp KP_SLASH  &none  &none     &none      &none  &none                                                    &mo 4      &none  &kp KP_NUM  &none         &none       &kp KP_MULTIPLY  &kp KP_PLUS
&kp TAB          &tog 3        &none  &none     &none      &none  &none                                                    &none      &none  &kp KP_N7   &kp KP_N8     &kp KP_N9   &none            &none
&kp ESC          &none         &none  &none     &none      &none  &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &none  &kp KP_N4   &kp KP_N5     &kp KP_N6   &none            &none
&kp LSHFT        &none         &none  &none     &none      &none                       &kp HOME      &kp PG_UP                        &none  &kp KP_N1   &kp KP_N2     &kp KP_N3   &none            &kp RSHFT
&mo 2            &none         &none  &kp LEFT  &kp RIGHT         &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp KP_N0         &kp DOWN    &kp UP_ARROW  &kp KP_DOT  &none            &kp KP_ENTER
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &none            &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &to 0        &to 1  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_DEC  &bl BL_INC  &none  &none  &none
            >;
        };
    };
};
